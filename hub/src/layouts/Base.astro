---
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // 블로그(themes/CleanWhite)와 정확히 같은 localStorage 키·값("light"/"dark")을
      // 써서 허브 ↔ 블로그를 오가거나 두 탭을 동시에 열어도 테마가 어긋나지 않게 한다.
      // 페인트 전에 동기적으로 실행해 깜빡임(FOUC)을 막는다.
      (function () {
        const STORAGE_KEY = 'cleanwhite-theme';
        function systemPref() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        function currentTheme() {
          try {
            const stored = localStorage.getItem(STORAGE_KEY);
            if (stored === 'light' || stored === 'dark') return stored;
          } catch (e) {}
          return systemPref();
        }
        document.documentElement.setAttribute('data-theme', currentTheme());
      })();
    </script>
  </head>
  <body>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="테마 전환"
      title="라이트/다크 전환"
    >
      <span class="icon-light">☀️</span>
      <span class="icon-dark">🌙</span>
    </button>
    <slot />
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'cleanwhite-theme';

        function apply(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          // 같은 페이지 안에서 테마에 반응해야 하는 컴포넌트(그래프 등)에 알림
          window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme } }));
        }

        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function () {
            const now = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
            const next = now === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem(STORAGE_KEY, next);
            } catch (e) {}
            apply(next);
          });
        }

        // 같은 브라우저의 다른 탭(블로그 포함)에서 테마를 바꾸면 이 탭도 즉시 따라간다.
        window.addEventListener('storage', function (e) {
          if (e.key === STORAGE_KEY && (e.newValue === 'light' || e.newValue === 'dark')) {
            apply(e.newValue);
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;

    --hub-bg: #fafafa;
    --hub-text: #16181d;
    --hub-text-muted: #565d6b;
    --hub-card-bg: #ffffff;
    --hub-card-border: #e4e6ea;
    --hub-card-border-hover: #b9bfca;

    --hub-graph-person: #c15f45;
    --hub-graph-company: #2f5f78;
    --hub-graph-group: #6b5b95;
    --hub-graph-place: #3c8a5f;
    --hub-graph-event: #b8952f;
    --hub-graph-edge: #98a1ad;
    --hub-graph-label: #16181d;
    --hub-graph-edge-label-bg: #fafafa;
    --hub-graph-ot: #a97d3d;
    --hub-graph-nt: #3a6ea5;

    --hub-accent-rgb: 47, 95, 120;
    --hub-accent2-rgb: 184, 149, 47;
  }

  :root[data-theme='dark'] {
    --hub-bg: #0b0d12;
    --hub-text: #f2f2f2;
    --hub-text-muted: #a8adb8;
    --hub-card-bg: #12151c;
    --hub-card-border: #262b36;
    --hub-card-border-hover: #4a5468;

    --hub-graph-person: #e07a5f;
    --hub-graph-company: #4a7c9b;
    --hub-graph-group: #9b8ac4;
    --hub-graph-place: #6bbf8e;
    --hub-graph-event: #d9b657;
    --hub-graph-edge: #4a5468;
    --hub-graph-label: #f2f2f2;
    --hub-graph-edge-label-bg: #0b0d12;
    --hub-graph-ot: #c99a5c;
    --hub-graph-nt: #6fa3d8;

    --hub-accent-rgb: 74, 124, 155;
    --hub-accent2-rgb: 217, 182, 87;
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans KR', sans-serif;
    background: var(--hub-bg);
    color: var(--hub-text);
  }

  .theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 100;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--hub-card-border);
    background: var(--hub-card-bg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    line-height: 1;
  }
  .theme-toggle .icon-light,
  .theme-toggle .icon-dark {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-light {
    display: inline;
  }
  :root:not([data-theme='dark']) .theme-toggle .icon-dark {
    display: inline;
  }

  /* 관계도 그래프(성경/블로그) 공용 확대·축소 컨트롤 — createZoomControls()가 그래프
     wrapper 안에 렌더링한다. wrapper는 position:relative여야 이 버튼이 그래프 위에 겹쳐진다. */
  .hub-zoom-controls {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hub-zoom-controls button {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--hub-card-border);
    background: var(--hub-card-bg);
    color: var(--hub-text);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .hub-zoom-controls button:hover {
    border-color: var(--hub-card-border-hover);
  }
</style>
