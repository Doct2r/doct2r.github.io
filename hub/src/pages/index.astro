---
import Base from '../layouts/Base.astro';

const links = [
  { href: '/blog/', title: '블로그', desc: '기술과 생각을 정리하는 500편+의 글' },
  { href: '/graph', title: '관계도', desc: '블로그·성경 등 여러 관계도 모음' },
];
---
<Base title="Doct2r" description="Doct2r의 홈 — 블로그와 관계도 그래프로 이어지는 허브">
  <main class="hero">
    <h1>Doct2r</h1>
    <p class="tagline">기술과 생각을 기록하고, 그 기록들이 서로 어떻게 얽혀 있는지 들여다봅니다.</p>
    <nav class="cards">
      {links.map((l) => (
        <a class="card" href={l.href}>
          <span class="card-title">{l.title}</span>
          <span class="card-desc">{l.desc}</span>
        </a>
      ))}
    </nav>
  </main>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
    box-sizing: border-box;
  }
  h1 {
    font-size: 3rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .tagline {
    color: var(--hub-text-muted);
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--hub-card-border);
    background: var(--hub-card-bg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--hub-card-border-hover);
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .card-desc {
    font-size: 0.9rem;
    color: var(--hub-text-muted);
  }
</style>
