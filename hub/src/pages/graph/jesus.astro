---
import Base from '../../layouts/Base.astro';
import graphData from '../../data/jesus-genealogy.json';
---
<Base title="예수의 족보 — Doct2r" description="아담부터 예수까지, 창세기와 마태복음 족보를 잇는 관계도">
  <header>
    <a href="/graph" class="back">← 관계도 목록</a>
    <h1>예수의 족보</h1>
    <p class="notice">
      창세기 5장(아담~노아)·11장(셈~데라)을 잇고, 그 이후는 마태복음 1장의 족보(아브라함~예수)를
      그대로 따랐습니다. 마태의 목록은 3×14세대로 맞추기 위해 열왕기·역대기의 일부 왕(요람↔웃시야
      사이 3대, 요시야↔여고냐 사이 1대)을 건너뛰며, 누가복음 3장은 다윗 이후 솔로몬이 아닌 나단의
      후손을 거치는 다른 계보를 전합니다 — 이 그래프는 마태의 한 줄만 그렸습니다. 다말·라합·룻·밧세바·
      마리아 등 이름이 명시된 여성 조상도 함께 표시했습니다.
    </p>
  </header>
  <div class="graph-wrap">
    <div id="cy"></div>
  </div>
  <ul class="legend">
    <li><span class="dot person"></span> 인물</li>
    <li><span class="dot woman"></span> 이름이 명시된 여성 조상</li>
  </ul>

  <script is:inline type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

  <script>
    import { createThemedGraph, createZoomControls } from '../../lib/cytoscape-theme';
    import type { GraphData } from '../../lib/graph-types';

    const raw = document.getElementById('graph-data')?.textContent ?? '{"nodes":[],"edges":[]}';
    const data = JSON.parse(raw) as GraphData;
    const wrapper = document.querySelector('.graph-wrap') as HTMLElement | null;
    const container = document.getElementById('cy');

    if (container) {
      // 아브라함 족보와 같은 이유로 breadthfirst(트리) 레이아웃을 쓴다 — 여기는 갈래가 거의 없는
      // 65개 노드짜리 단일 줄이라, 세대 층으로 쌓으면 사실상 아담→예수로 쭉 이어지는 긴 사슬이 된다.
      const cy = createThemedGraph(container, data, {
        person: { colorVar: '--hub-graph-person' },
        woman: { colorVar: '--hub-graph-place', shape: 'diamond' },
      }, {
        layout: {
          name: 'breadthfirst',
          directed: true,
          roots: ['adam'],
          spacingFactor: 1.1,
          padding: 40,
          animate: false,
        },
      });
      if (wrapper) {
        createZoomControls(wrapper, cy, () => cy.elements());
      }
    }
  </script>
</Base>

<style>
  header {
    padding: 1.5rem 2rem 0.5rem;
  }
  .back {
    color: var(--hub-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
  }
  .notice {
    color: var(--hub-text-muted);
    font-size: 0.85rem;
    max-width: 680px;
    line-height: 1.6;
  }
  .graph-wrap {
    position: relative;
  }
  #cy {
    width: 100%;
    height: 70vh;
    background: var(--hub-bg);
    touch-action: none;
  }
  .legend {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    padding: 0.5rem 2rem 1.5rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .dot.person {
    background: var(--hub-graph-person);
  }
  .dot.woman {
    background: var(--hub-graph-place);
    border-radius: 2px;
    transform: rotate(45deg);
    width: 8px;
    height: 8px;
  }

  @media (max-width: 640px) {
    header {
      padding: 1rem 1rem 0.5rem;
    }
    .notice {
      font-size: 0.8rem;
    }
    #cy {
      height: 60vh;
    }
    .legend {
      padding: 0.5rem 1rem 1.25rem;
      flex-wrap: wrap;
    }
  }
</style>
