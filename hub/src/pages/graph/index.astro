---
import Base from '../../layouts/Base.astro';

const graphs = [
  {
    href: '/graph/blog/',
    title: '블로그 관계도',
    desc: '블로그에 등장한 인물·기업의 관계',
    ready: true,
  },
  {
    href: null,
    title: '성경 관계도',
    desc: '시대별 인물·왕국의 변화를 시간 바로 훑어보는 그래프 (준비 중)',
    ready: false,
  },
];
---
<Base title="관계도 — Doct2r" description="Doct2r가 만든 여러 관계도 그래프 목록">
  <main class="hero">
    <a href="/" class="back">← 홈</a>
    <h1>관계도</h1>
    <p class="tagline">서로 다른 소재를 각자의 방식으로 그래프로 풀어봅니다.</p>
    <nav class="cards">
      {graphs.map((g) =>
        g.ready ? (
          <a class="card" href={g.href!}>
            <span class="card-title">{g.title}</span>
            <span class="card-desc">{g.desc}</span>
          </a>
        ) : (
          <div class="card disabled" aria-disabled="true">
            <span class="card-title">{g.title}</span>
            <span class="card-desc">{g.desc}</span>
          </div>
        )
      )}
    </nav>
  </main>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
    box-sizing: border-box;
  }
  .back {
    align-self: flex-start;
    color: var(--hub-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .tagline {
    color: var(--hub-text-muted);
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    width: 100%;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--hub-card-border);
    background: var(--hub-card-bg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:not(.disabled):hover {
    transform: translateY(-2px);
    border-color: var(--hub-card-border-hover);
  }
  .card.disabled {
    opacity: 0.5;
    cursor: default;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .card-desc {
    font-size: 0.9rem;
    color: var(--hub-text-muted);
  }
</style>
