---
import Base from '../../layouts/Base.astro';
import graphData from '../../data/bible-graph.json';
---
<Base title="성경 관계도 — Doct2r" description="시대별 인물·왕국의 변화를 시간 바로 훑어보는 관계도 (근사 연대)">
  <header>
    <a href="/graph" class="back">← 관계도 목록</a>
    <h1>성경 관계도</h1>
    <p class="notice">
      연대는 학계·전통 사이에 이견이 있는 근사값입니다. 하단 시간 바를 움직이면 그 시점에 활동한
      인물·왕국만 진하게 표시됩니다.
    </p>
  </header>
  <div id="cy"></div>
  <ul class="legend">
    <li><span class="dot person"></span> 인물</li>
    <li><span class="dot polity"></span> 왕국·제국</li>
  </ul>

  <div class="timebar">
    <span id="year-label" class="year-label">–</span>
    <input id="year-range" type="range" step="1" />
  </div>

  <script is:inline type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

  <script>
    import { createThemedGraph } from '../../lib/cytoscape-theme';
    import { applyTimeFilter, getTimeRange, formatYear } from '../../lib/graph-timeline';
    import type { GraphData } from '../../lib/graph-types';

    const raw = document.getElementById('graph-data')?.textContent ?? '{"nodes":[],"edges":[]}';
    const data = JSON.parse(raw) as GraphData;
    const container = document.getElementById('cy');
    const rangeInput = document.getElementById('year-range') as HTMLInputElement | null;
    const yearLabel = document.getElementById('year-label');

    if (container) {
      const cy = createThemedGraph(container, data, {
        person: '--hub-graph-person',
        polity: '--hub-graph-polity',
      });

      const range = getTimeRange(data);
      if (range && rangeInput && yearLabel) {
        rangeInput.min = String(range.min);
        rangeInput.max = String(range.max);
        rangeInput.value = String(range.min);

        const update = () => {
          const year = Number(rangeInput.value);
          yearLabel.textContent = formatYear(year);
          applyTimeFilter(cy, data, year);
        };

        rangeInput.addEventListener('input', update);
        update();
      }
    }
  </script>
</Base>

<style>
  header {
    padding: 1.5rem 2rem 0.5rem;
  }
  .back {
    color: var(--hub-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
  }
  .notice {
    color: var(--hub-text-muted);
    font-size: 0.85rem;
    max-width: 640px;
  }
  #cy {
    width: 100%;
    height: 62vh;
    background: var(--hub-bg);
  }
  .legend {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    padding: 0.5rem 2rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .dot.person {
    background: var(--hub-graph-person);
  }
  .dot.polity {
    background: var(--hub-graph-polity);
    border-radius: 2px;
  }
  .timebar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem 2rem;
  }
  .year-label {
    min-width: 8rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  #year-range {
    flex: 1;
    accent-color: var(--hub-graph-polity);
  }
</style>
