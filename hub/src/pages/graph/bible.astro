---
import Base from '../../layouts/Base.astro';
import graphData from '../../data/bible-graph.json';
import { getTimeRange, yearToPercent } from '../../lib/graph-timeline';
import type { GraphData } from '../../lib/graph-types';

// 구약/신약 전환점(기원후 0년) 표시 위치는 데이터의 연도 범위로 정해지므로 빌드 타임에 계산해 둔다.
const range = getTimeRange(graphData as GraphData);
const eraMarkerPct = range ? yearToPercent(0, range) : null;
---
<Base title="성경 관계도 — Doct2r" description="시대별 인물·왕국의 변화를 시간 바로 훑어보는 관계도 (근사 연대)">
  <header>
    <a href="/graph" class="back">← 관계도 목록</a>
    <h1>성경 관계도</h1>
    <p class="notice">
      연대는 학계·전통 사이에 이견이 있는 근사값입니다. 하단 시간 바를 움직이면 그 시점에 활동한
      인물·왕국만 진하게 표시됩니다.
    </p>
  </header>
  <div id="cy"></div>
  <ul class="legend">
    <li><span class="dot person"></span> 인물</li>
    <li><span class="dot group"></span> 집단(왕국·제국)</li>
    <li><span class="dot place"></span> 지역</li>
  </ul>

  <div class="timebar">
    <span id="year-label" class="year-label">–</span>
    <div class="track">
      {eraMarkerPct !== null && (
        <div class="era-marker" style={`left:${eraMarkerPct}%`}>
          <span class="era-marker-label">구약 ↔ 신약</span>
        </div>
      )}
      <input id="year-range" type="range" step="1" />
    </div>
  </div>

  <script is:inline type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />

  <script>
    import { createThemedGraph } from '../../lib/cytoscape-theme';
    import { applyTimeFilter, getTimeRange, formatYear } from '../../lib/graph-timeline';
    import type { GraphData } from '../../lib/graph-types';

    const raw = document.getElementById('graph-data')?.textContent ?? '{"nodes":[],"edges":[]}';
    const data = JSON.parse(raw) as GraphData;
    const container = document.getElementById('cy');
    const rangeInput = document.getElementById('year-range') as HTMLInputElement | null;
    const yearLabel = document.getElementById('year-label');

    if (container) {
      const cy = createThemedGraph(container, data, {
        person: { colorVar: '--hub-graph-person' },
        group: { colorVar: '--hub-graph-group', shape: 'round-rectangle' },
        place: { colorVar: '--hub-graph-place', shape: 'diamond' },
      });

      const range = getTimeRange(data);
      if (range && rangeInput && yearLabel) {
        rangeInput.min = String(range.min);
        rangeInput.max = String(range.max);
        rangeInput.value = String(range.min);

        const update = () => {
          const year = Number(rangeInput.value);
          yearLabel.textContent = formatYear(year);
          applyTimeFilter(cy, data, year);
        };

        rangeInput.addEventListener('input', update);
        update();
      }
    }
  </script>
</Base>

<style>
  header {
    padding: 1.5rem 2rem 0.5rem;
  }
  .back {
    color: var(--hub-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
  }
  .notice {
    color: var(--hub-text-muted);
    font-size: 0.85rem;
    max-width: 640px;
  }
  #cy {
    width: 100%;
    height: 62vh;
    background: var(--hub-bg);
  }
  .legend {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    padding: 0.5rem 2rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .dot.person {
    background: var(--hub-graph-person);
  }
  .dot.group {
    background: var(--hub-graph-group);
    border-radius: 2px;
  }
  .dot.place {
    background: var(--hub-graph-place);
    border-radius: 2px;
    transform: rotate(45deg);
    width: 8px;
    height: 8px;
  }
  .timebar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem 2.5rem;
  }
  .year-label {
    min-width: 8rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .track {
    position: relative;
    flex: 1;
  }
  #year-range {
    width: 100%;
    accent-color: var(--hub-graph-group);
  }
  .era-marker {
    position: absolute;
    top: -0.6rem;
    bottom: -0.6rem;
    width: 0;
    border-left: 2px dashed var(--hub-text-muted);
    pointer-events: none;
  }
  .era-marker-label {
    position: absolute;
    top: -1.3rem;
    left: 0.4rem;
    font-size: 0.7rem;
    color: var(--hub-text-muted);
    white-space: nowrap;
  }
</style>
