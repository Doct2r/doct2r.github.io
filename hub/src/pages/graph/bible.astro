---
import Base from '../../layouts/Base.astro';
import graphData from '../../data/bible-graph.json';
import writingPeriodsData from '../../data/bible-writing-periods.json';
import { buildTimelineScale, collectYearBreakpoints } from '../../lib/graph-timeline';
import type { GraphData } from '../../lib/graph-types';

// 태초~노아처럼 사건이 거의 없는 수천 년짜리 공백이 선형 축에서 시간 바 대부분을 차지해버려서,
// 실제로 인물·사건이 몰린 구간(왕국시대~신약)이 한쪽 구석에 짓눌리는 문제가 있었다. 그래서
// 실제 데이터가 있는 지점(breakpoint)들만 모아 그 사이의 "빈 구간"을 압축하는 축을 쓴다.
// 클라이언트 스크립트도 똑같은 breakpoint 집합으로 같은 축을 다시 만들어야 슬라이더 위치와
// 여기서 미리 계산해 둔 구약/신약 표시선·집필 시기 막대 위치가 어긋나지 않는다.
const writingYears = writingPeriodsData.periods.flatMap((p) => [p.start, p.end]);
const breakpoints = collectYearBreakpoints(graphData as GraphData, [0, ...writingYears]);
const scale = buildTimelineScale(breakpoints);
const eraMarkerPct = scale.toPercent(0);
const writingBands = writingPeriodsData.periods.map((p) => {
  const left = scale.toPercent(p.start);
  const right = scale.toPercent(p.end);
  return { ...p, leftPct: left, widthPct: right - left };
});
---
<Base title="성경 관계도 — Doct2r" description="시대별 인물·왕국의 변화를 시간 바로 훑어보는 관계도 (근사 연대)">
  <header>
    <a href="/graph" class="back">← 관계도 목록</a>
    <h1>성경 관계도</h1>
    <p class="notice">
      연대는 학계·전통 사이에 이견이 있는 근사값입니다. 하단 시간 바를 움직이면 그 시점에 활동한
      인물·왕국만 진하게 표시됩니다.
    </p>
  </header>
  <div class="graph-wrap">
    <div id="cy"></div>
  </div>
  <ul class="legend">
    <li><span class="dot person"></span> 인물</li>
    <li><span class="dot group"></span> 집단(왕국·제국)</li>
    <li><span class="dot place"></span> 지역</li>
    <li><span class="dot-star" aria-hidden="true">★</span> 사건</li>
  </ul>

  <div class="timebar">
    <span id="year-label" class="year-label">–</span>
    <div class="track">
      <div class="era-marker" style={`left:${eraMarkerPct}%`}>
        <span class="era-marker-label">구약 ↔ 신약</span>
      </div>
      <input id="year-range" type="range" step="0.05" min="0" max="100" style={`--era-pct:${eraMarkerPct}%`} />
    </div>
  </div>

  <div class="writing-toggle-row">
    <button id="writing-toggle" type="button" class="writing-toggle">성경 집필 시기 표시</button>
  </div>
  <div id="writing-periods" class="writing-periods" hidden>
    <p class="writing-note">
      아래 막대는 본문 속 사건이 아니라, 각 책 묶음이 실제로 <strong>기록됐다고 보는(추정) 시기</strong>입니다 —
      위 시간 바가 가리키는 사건 시점과는 다른 축입니다. 연대는 학설에 따라 편차가 큽니다.
    </p>
    {writingBands.map((b) => (
      <div class="wp-row">
        <span class="wp-label">{b.label}</span>
        <div class="wp-track">
          <div class="wp-bar" style={`left:${b.leftPct}%;width:${b.widthPct}%`}></div>
        </div>
      </div>
    ))}
    <div class="wp-row wp-cursor-row">
      <span class="wp-label"></span>
      <div class="wp-track">
        <div id="wp-cursor" class="wp-cursor"></div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />
  <script
    is:inline
    type="application/json"
    id="writing-periods-data"
    set:html={JSON.stringify(writingPeriodsData)}
  />

  <script>
    import { createThemedGraph, createZoomControls } from '../../lib/cytoscape-theme';
    import { applyTimeFilter, formatYear, buildTimelineScale, collectYearBreakpoints } from '../../lib/graph-timeline';
    import type { GraphData } from '../../lib/graph-types';

    const raw = document.getElementById('graph-data')?.textContent ?? '{"nodes":[],"edges":[]}';
    const data = JSON.parse(raw) as GraphData;
    const writingRaw = document.getElementById('writing-periods-data')?.textContent ?? '{"periods":[]}';
    const writingPeriods = (JSON.parse(writingRaw) as { periods: { start: number; end: number }[] }).periods;
    const wrapper = document.querySelector('.graph-wrap') as HTMLElement | null;
    const container = document.getElementById('cy');
    const rangeInput = document.getElementById('year-range') as HTMLInputElement | null;
    const yearLabel = document.getElementById('year-label');
    const wpCursor = document.getElementById('wp-cursor');

    // 빌드 타임(frontmatter)과 똑같은 breakpoint 집합으로 똑같은 압축 축을 다시 만든다 —
    // 그래야 여기서 그리는 구약/신약 표시선·집필 시기 막대와 슬라이더 위치가 어긋나지 않는다.
    const writingYears = writingPeriods.flatMap((p) => [p.start, p.end]);
    const breakpoints = collectYearBreakpoints(data, [0, ...writingYears]);
    const scale = buildTimelineScale(breakpoints);

    if (container) {
      const cy = createThemedGraph(container, data, {
        person: { colorVar: '--hub-graph-person' },
        group: { colorVar: '--hub-graph-group', shape: 'round-rectangle' },
        place: { colorVar: '--hub-graph-place', shape: 'diamond' },
        event: { colorVar: '--hub-graph-event', shape: 'star' },
      });

      if (wrapper) {
        createZoomControls(wrapper, cy, () => cy.nodes(':visible'));
      }

      if (rangeInput && yearLabel) {
        rangeInput.value = '0';

        const update = () => {
          const pct = Number(rangeInput.value);
          const year = scale.toYear(pct);
          yearLabel.textContent = formatYear(year);
          applyTimeFilter(cy, data, year);
          // 드래그한 지점 왼쪽(이미 지나온 시점)은 구약/신약 색을 그대로 보여주고,
          // 오른쪽(아직 안 온 시점)은 회색으로 덮어서 바 자체가 드래그에 반응하게 한다.
          rangeInput.style.setProperty('--fill-pct', `${pct}%`);
          if (wpCursor) {
            wpCursor.style.left = `${pct}%`;
          }
        };

        rangeInput.addEventListener('input', update);
        update();
      }
    }

    const writingToggle = document.getElementById('writing-toggle');
    const writingPanel = document.getElementById('writing-periods') as HTMLElement | null;
    if (writingToggle && writingPanel) {
      writingToggle.addEventListener('click', () => {
        const willShow = writingPanel.hidden;
        writingPanel.hidden = !willShow;
        writingToggle.textContent = willShow ? '성경 집필 시기 숨기기' : '성경 집필 시기 표시';
      });
    }
  </script>
</Base>

<style>
  header {
    padding: 1.5rem 2rem 0.5rem;
  }
  .back {
    color: var(--hub-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  h1 {
    margin: 0.5rem 0 0.25rem;
  }
  .notice {
    color: var(--hub-text-muted);
    font-size: 0.85rem;
    max-width: 640px;
  }
  .graph-wrap {
    position: relative;
  }
  #cy {
    width: 100%;
    height: 62vh;
    background: var(--hub-bg);
    /* 모바일에서 손가락 드래그를 페이지 스크롤이 아니라 그래프 팬(pan)으로 넘겨준다 */
    touch-action: none;
  }
  .legend {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    padding: 0.5rem 2rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
  .dot.person {
    background: var(--hub-graph-person);
  }
  .dot.group {
    background: var(--hub-graph-group);
    border-radius: 2px;
  }
  .dot.place {
    background: var(--hub-graph-place);
    border-radius: 2px;
    transform: rotate(45deg);
    width: 8px;
    height: 8px;
  }
  .dot-star {
    display: inline-block;
    margin-right: 0.3rem;
    color: var(--hub-graph-event);
    font-size: 0.9rem;
    line-height: 1;
  }
  .timebar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem 2.5rem;
  }
  .year-label {
    min-width: 8rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .track {
    position: relative;
    flex: 1;
  }
  #year-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 1.4rem;
    background: transparent;
    margin: 0;
    /* --era-pct는 인라인 style로 페이지마다 지정(구약↔신약 전환점 위치),
       --fill-pct는 드래그할 때마다 JS가 갱신(지금 시점까지 지나온 위치) */
    --era-pct: 100%;
    --fill-pct: 0%;
  }
  /* 배경을 두 겹 쌓는다: 위 레이어(회색, 아직 안 지나온 구간)가 아래 레이어(구약/신약 색)를
     드래그 지점 오른쪽만 덮어서, 손잡이를 당길 때마다 바 자체의 색이 함께 바뀌게 한다. */
  #year-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background:
      linear-gradient(
        to right,
        transparent 0%,
        transparent var(--fill-pct),
        var(--hub-card-border) var(--fill-pct),
        var(--hub-card-border) 100%
      ),
      linear-gradient(
        to right,
        var(--hub-graph-ot) 0%,
        var(--hub-graph-ot) var(--era-pct),
        var(--hub-graph-nt) var(--era-pct),
        var(--hub-graph-nt) 100%
      );
  }
  #year-range::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background:
      linear-gradient(
        to right,
        transparent 0%,
        transparent var(--fill-pct),
        var(--hub-card-border) var(--fill-pct),
        var(--hub-card-border) 100%
      ),
      linear-gradient(
        to right,
        var(--hub-graph-ot) 0%,
        var(--hub-graph-ot) var(--era-pct),
        var(--hub-graph-nt) var(--era-pct),
        var(--hub-graph-nt) 100%
      );
  }
  #year-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--hub-text);
    border: 2px solid var(--hub-bg);
    margin-top: -4px;
    cursor: pointer;
  }
  #year-range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--hub-text);
    border: 2px solid var(--hub-bg);
    cursor: pointer;
  }
  .era-marker {
    position: absolute;
    top: -0.6rem;
    bottom: -0.6rem;
    width: 0;
    border-left: 2px dashed var(--hub-text-muted);
    pointer-events: none;
  }
  .era-marker-label {
    position: absolute;
    top: -1.3rem;
    /* 이 데이터셋에서는 전환점이 대체로 바 오른쪽 끝 근처라, 왼쪽으로 붙이면(right 기준)
       라벨이 트랙 밖으로 잘릴 일이 없다. */
    right: 0.4rem;
    font-size: 0.7rem;
    color: var(--hub-text-muted);
    white-space: nowrap;
  }
  .writing-toggle-row {
    padding: 0 2rem;
  }
  .writing-toggle {
    font-size: 0.85rem;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--hub-card-border);
    background: var(--hub-card-bg);
    color: var(--hub-text);
    cursor: pointer;
  }
  .writing-toggle:hover {
    border-color: var(--hub-card-border-hover);
  }
  .writing-periods {
    padding: 1rem 2rem 2rem;
  }
  .writing-note {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    color: var(--hub-text-muted);
    max-width: 640px;
  }
  .wp-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .wp-label {
    min-width: 8rem;
    font-size: 0.78rem;
    color: var(--hub-text-muted);
  }
  .wp-track {
    position: relative;
    flex: 1;
    height: 0.85rem;
    background: var(--hub-card-border);
    border-radius: 4px;
  }
  .wp-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--hub-graph-place);
    border-radius: 4px;
    min-width: 2px;
  }
  .wp-cursor-row {
    margin-top: 0.6rem;
  }
  .wp-cursor-row .wp-track {
    height: 0;
    background: none;
    overflow: visible;
  }
  .wp-cursor {
    position: absolute;
    top: -0.4rem;
    bottom: -0.4rem;
    width: 0;
    border-left: 2px solid var(--hub-graph-person);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    header {
      padding: 1rem 1rem 0.5rem;
    }
    .notice {
      font-size: 0.8rem;
    }
    #cy {
      height: 52vh;
    }
    .legend {
      padding: 0.5rem 1rem;
      gap: 0.6rem 1rem;
      flex-wrap: wrap;
      font-size: 0.78rem;
    }
    .timebar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.4rem;
      padding: 0.75rem 1rem 2.25rem;
    }
    .year-label {
      min-width: 0;
      text-align: center;
    }
    /* 터치로 잡기 쉽게 손잡이·트랙을 데스크톱보다 크게 */
    #year-range {
      height: 2rem;
    }
    #year-range::-webkit-slider-thumb {
      width: 22px;
      height: 22px;
      margin-top: -8px;
    }
    #year-range::-moz-range-thumb {
      width: 22px;
      height: 22px;
    }
    .writing-toggle-row {
      padding: 0 1rem;
    }
    .writing-periods {
      padding: 0.75rem 1rem 1.5rem;
    }
    .wp-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      margin-bottom: 0.7rem;
    }
    .wp-label {
      min-width: 0;
    }
    .wp-cursor-row .wp-label {
      display: none;
    }
  }
</style>
